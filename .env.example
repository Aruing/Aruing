# 复制为 .env 后填写真实值（.env 已被 gitignore，勿提交密钥）
#   cp .env.example .env
#
# 三个 LLM 变量都非空时，wiring 启用真角色；任一缺失则走全 fake 闭环。
# 本地调试推荐：make run-llm / make print-env（自动 source .env）

ARUING_LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
ARUING_LLM_API_KEY=
ARUING_LLM_MODEL=

# 可选：kubectl 绝对路径；不设则用 PATH 中的 kubectl
# ARUING_KUBECTL_PATH=/usr/local/bin/kubectl
