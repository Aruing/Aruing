# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
bin/
/aruing
*.exe
*.exe~
*.dll
*.so
*.dylib

# GoReleaser build output (snapshot / release artifacts land in dist/)
dist/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env files with secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Local config with secrets (keep aruing.example.yaml tracked)
/aruing.yaml
/playground/

# Local agent skill installs
/.agents/
/agent/
/skills-lock.json

# Scenario harness: ephemeral kind kubeconfigs (written by scripts/scenario-up.sh)
/scenarios/.kube/
/scenarios/.smoke/

# macOS noise
.DS_Store
.benchvenv/

# python 出图脚本缓存
__pycache__/

# 本地实验出图 venv（bench-plot.py matplotlib，见 scripts/bench-plot.py 头注释）
.venv/

# 实验数据不进公开仓（归档到笔记仓 gproject/中期/实验数据/）
eval/results/
