# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
bin/
/aruing
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env files with secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Local config with secrets (keep aruing.example.yaml tracked)
/aruing.yaml
/playground/

# Local agent skill installs
/.agents/
/agent/
/skills-lock.json

# Scenario harness: ephemeral kind kubeconfigs (written by scripts/scenario-up.sh)
/scenarios/.kube/
/scenarios/.smoke/

# macOS noise
.DS_Store
